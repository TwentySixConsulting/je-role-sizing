# Copy to .env.local for local development, and set the same three in Vercel.
#
# Without these the app falls back to browser-only storage and shows a
# "Local copy" warning in the header. With them it uses the shared team
# database and asks for the team password on load.

VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable ("anon") key. Safe to ship: row level security means it reads
# nothing until the team password has been accepted.
VITE_SUPABASE_ANON_KEY=your-anon-key

# The shared team account the password signs in. Must match the user created in
# Supabase Auth. Not a secret.
VITE_TEAM_EMAIL=rolesizing@twentysixconsulting.co.uk
