# Copy to .env.local for local development. In production these are set as
# GitHub repository secrets and read by .github/workflows/deploy.yml.

# ---------------------------------------------------------------- sign-in ---
# username:sha256-of-password pairs, comma separated. Generate with
#   ./scripts/make-user-hashes.sh millie:somepassword jane:anotherpassword
# Leave unset and the site is open to anyone with the link.
#
# Be clear what this is: a static site has to ship whatever it checks against,
# so this keeps the tool out of casual view rather than genuinely securing it.
# Setting the Supabase pair below replaces it with real accounts.
VITE_APP_USERS=

# --------------------------------------------------- shared team database ---
# Set both and the app stores roles in Supabase instead of the browser: one
# shared library for the team, live updates, and sign-in enforced by the
# database rather than by the page.
VITE_SUPABASE_URL=
# The publishable ("anon") key. Safe to ship: row level security means it reads
# nothing until someone has signed in.
VITE_SUPABASE_ANON_KEY=
# Bare usernames are completed with this domain to make the Supabase Auth email.
VITE_TEAM_EMAIL_DOMAIN=twentysixconsulting.co.uk
